# Aurora Ledger - Root Environment Variables Example
# See frontend/.env.example and backend/.env.example for specific module configurations.

# When deploying, you usually don't need a root .env.
# This file serves as a reference for local docker-compose or similar orchestrations.

# Backend (Port 5000)
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://username:password@localhost:5432/aurora?sslmode=disable
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Frontend (Port 5173)
VITE_API_URL=http://localhost:5000/api
